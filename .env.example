# Configuração de chaves de API para o Assistente IA (Google Gemini)
# Obtenha suas chaves em: https://aistudio.google.com/
# NUNCA comite o arquivo .env real no controle de versão!

GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=

# Criptografia Simétrica (Fernet) e Derivação PBKDF2-HMAC-SHA256
FERNET_MASTER_KEY=
CHURRAS_SALT=
ADMIN_RECOVERY_CODE=

# Configuração Opcional de SMTP Pessoal (Recuperação de Senha por E-mail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=

